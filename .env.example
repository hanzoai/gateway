# ============================================================================
# Hanzo Inference Environment Configuration
# ============================================================================
# This file contains all available environment variables for configuring
# the Hanzo inference node. Copy this file to .env and customize values.
#
# Quick Start:
#   1. cp .env.example .env
#   2. Edit .env and set your API keys
#   3. docker compose up -d
# ============================================================================

# ============================================================================
# Docker Configuration
# ============================================================================
HANZO_VERSION=latest                    # Docker image version (latest, 1.0.0, etc.)

# ============================================================================
# Network Configuration
# ============================================================================
NODE_API_IP=0.0.0.0                     # API bind address
NODE_IP=0.0.0.0                         # Node bind address
NODE_API_PORT=9550                      # HTTP API port
NODE_WS_PORT=9551                       # WebSocket port
NODE_PORT=9552                          # P2P port
NODE_HTTPS_PORT=9553                    # HTTPS API port

# ============================================================================
# Identity and Security
# ============================================================================
# Generate with: openssl rand -base64 32
IDENTITY_SECRET_KEY=                    # Required: Node identity key
ENCRYPTION_SECRET_KEY=                  # Required: Encryption key
GLOBAL_IDENTITY_NAME=@@my_local_ai.sep-hanzo  # Node identity name

# ============================================================================
# Node Behavior
# ============================================================================
PING_INTERVAL_SECS=0                    # Ping interval (0 = disabled)
STARTING_NUM_QR_PROFILES=1              # Initial QR profiles to create
STARTING_NUM_QR_DEVICES=1               # Initial devices to create
FIRST_DEVICE_NEEDS_REGISTRATION_CODE=false  # Require registration code
SKIP_IMPORT_FROM_DIRECTORY=false        # Skip directory import
NO_SECRET_FILE=true                     # Don't use secret files (use env vars)

# ============================================================================
# Logging Configuration
# ============================================================================
RUST_LOG=debug,error,info               # Rust log levels
LOG_SIMPLE=true                         # Simple log format
LOG_ALL=1                               # Log everything

# ============================================================================
# AI Provider Configuration
# ============================================================================
EMBEDDINGS_SERVER_URL=                  # Optional: Embeddings server URL
PROXY_IDENTITY=@@relayer_pub_01.sep-hanzo  # Proxy identity

# ============================================================================
# Multi-Provider AI Agents Configuration
# ============================================================================
# Configure multiple AI providers by providing comma-separated lists.
# All lists must have the same number of entries.
#
# Supported Providers:
#   - DigitalOcean Gradient AI: https://inference.do-ai.run
#   - OpenAI: https://api.openai.com
#   - Anthropic Claude: https://api.anthropic.com
#
# Example: Multiple providers
# INITIAL_AGENT_NAMES=do_qwen32b,do_llama33_70b,openai_gpt4o,claude_sonnet
# INITIAL_AGENT_URLS=https://inference.do-ai.run,https://inference.do-ai.run,https://api.openai.com,https://api.anthropic.com
# INITIAL_AGENT_MODELS=openai:alibaba-qwen3-32b,openai:llama3.3-70b-instruct,openai:gpt-4o,anthropic:claude-3-5-sonnet-20241022
# INITIAL_AGENT_API_KEYS=sk-do-xxx,sk-do-xxx,sk-proj-xxx,sk-ant-xxx
# ============================================================================

# Agent Names (comma-separated, no spaces)
INITIAL_AGENT_NAMES=do_qwen32b

# Agent URLs (comma-separated, no spaces)
INITIAL_AGENT_URLS=https://inference.do-ai.run

# Agent Models (comma-separated, no spaces)
# Format: provider:model-name
INITIAL_AGENT_MODELS=openai:alibaba-qwen3-32b

# Agent API Keys (comma-separated, no spaces)
# REQUIRED: Set your API keys here
INITIAL_AGENT_API_KEYS=

# ============================================================================
# Storage Configuration
# ============================================================================
NODE_STORAGE_PATH=hanzo-storage         # Storage directory path

# ============================================================================
# Gateway Configuration (Optional)
# ============================================================================
# Uncomment if using the inference gateway

# Provider API Keys
# DIGITALOCEAN_API_KEY=sk-do-YOUR_KEY_HERE        # For free tier chat models
# VOYAGE_API_KEY=pa-YOUR_KEY_HERE                 # For Voyage AI embeddings (free tier default)
# OPENAI_API_KEY=sk-proj-YOUR_KEY_HERE
# ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# Gateway Security
# JWT_SECRET=                           # Generate with: openssl rand -base64 32

# Gateway Ports
# INFERENCE_PORT=3001
# EMBEDDING_PORT=3002

# Rate Limiting
# FREE_TIER_REQUESTS_PER_DAY=100
# FREE_TIER_TOKENS_PER_DAY=10000

# Cost Control
# DAILY_BUDGET_USD=50.00
# MONTHLY_BUDGET_USD=1000.00

# ============================================================================
# Common Provider Configurations
# ============================================================================

# -------------------------
# DigitalOcean Only (Default)
# -------------------------
# INITIAL_AGENT_NAMES=do_qwen32b
# INITIAL_AGENT_URLS=https://inference.do-ai.run
# INITIAL_AGENT_MODELS=openai:alibaba-qwen3-32b
# INITIAL_AGENT_API_KEYS=sk-do-YOUR_KEY

# -------------------------
# DigitalOcean + OpenAI
# -------------------------
# INITIAL_AGENT_NAMES=do_qwen32b,openai_gpt4o
# INITIAL_AGENT_URLS=https://inference.do-ai.run,https://api.openai.com
# INITIAL_AGENT_MODELS=openai:alibaba-qwen3-32b,openai:gpt-4o
# INITIAL_AGENT_API_KEYS=sk-do-YOUR_KEY,sk-proj-YOUR_KEY

# -------------------------
# DigitalOcean + Claude
# -------------------------
# INITIAL_AGENT_NAMES=do_qwen32b,claude_sonnet
# INITIAL_AGENT_URLS=https://inference.do-ai.run,https://api.anthropic.com
# INITIAL_AGENT_MODELS=openai:alibaba-qwen3-32b,anthropic:claude-3-5-sonnet-20241022
# INITIAL_AGENT_API_KEYS=sk-do-YOUR_KEY,sk-ant-YOUR_KEY

# -------------------------
# All Providers
# -------------------------
# INITIAL_AGENT_NAMES=do_qwen32b,do_llama33_70b,openai_gpt4o,claude_sonnet
# INITIAL_AGENT_URLS=https://inference.do-ai.run,https://inference.do-ai.run,https://api.openai.com,https://api.anthropic.com
# INITIAL_AGENT_MODELS=openai:alibaba-qwen3-32b,openai:llama3.3-70b-instruct,openai:gpt-4o,anthropic:claude-3-5-sonnet-20241022
# INITIAL_AGENT_API_KEYS=sk-do-key1,sk-do-key1,sk-proj-key2,sk-ant-key3

# ============================================================================
# Available Models by Provider
# ============================================================================

# DigitalOcean Gradient AI ($0.30-$1.20 per 1M tokens)
# - openai:alibaba-qwen3-32b              (Default, best value)
# - openai:llama3.3-70b-instruct          (High quality)
# - openai:llama3.1-8b-instruct           (Fast, cheap)
# - openai:mistral-7b-instruct-v0.3       (Efficient)

# OpenAI ($2-$60 per 1M tokens)
# - openai:gpt-4o                         (Latest GPT-4)
# - openai:gpt-4o-mini                    (Affordable GPT-4)
# - openai:o1                             (Reasoning model)

# Anthropic Claude ($3-$15 per 1M tokens)
# - anthropic:claude-3-5-sonnet-20241022  (Latest, best)
# - anthropic:claude-3-opus-20240229      (Most capable)
# - anthropic:claude-3-sonnet-20240229    (Balanced)
# - anthropic:claude-3-haiku-20240307     (Fast, cheap)

# ============================================================================
# Security Notes
# ============================================================================
# 1. Never commit .env file to version control
# 2. Use strong random keys for secrets
# 3. Rotate API keys regularly
# 4. Limit API key permissions when possible
# 5. Monitor usage and costs
# 6. Use firewall rules to restrict access
# 7. Enable SSL/TLS in production
# 8. Keep Docker images updated
