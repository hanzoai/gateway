#!/bin/sh

set -e

USER=gateway

if ! getent passwd $USER >/dev/null ; then
  adduser --system --disabled-login --gecos "Hanzo Gateway" --shell /bin/false --no-create-home $USER > /dev/null
fi

if [ -x "/etc/init.d/gateway" ] || [ -e "/etc/init/gateway.conf" ]; then
	service gateway stop || exit $?
fi
