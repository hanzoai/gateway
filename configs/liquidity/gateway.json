{
  "$schema": "https://www.krakend.io/schema/v3.json",
  "version": 3,
  "name": "Liquidity API Gateway",
  "port": 8080,
  "timeout": "120s",
  "cache_ttl": "0s",
  "output_encoding": "no-op",
  "extra_config": {
    "router": {
      "return_error_msg": true
    },
    "qos/ratelimit/router": {
      "max_rate": 5000,
      "client_max_rate": 100,
      "strategy": "ip"
    },
    "telemetry/logging": {
      "level": "INFO",
      "prefix": "[GATEWAY]",
      "syslog": false,
      "stdout": true
    },
    "security/cors": {
      "allow_origins": [
        "https://liquidity.io",
        "https://*.liquidity.io",
        "https://exchange.next.satschel.com",
        "https://exchange.alpha.satschel.com",
        "https://api.next.satschel.com",
        "https://api.alpha.satschel.com",
        "https://*.satschel.com"
      ],
      "allow_methods": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"],
      "allow_headers": ["Origin", "Authorization", "Content-Type", "Accept", "X-Requested-With", "X-Org-Id", "X-Project-Id", "X-Request-ID"],
      "expose_headers": ["Content-Length", "X-Request-ID"],
      "max_age": "12h"
    }
  },
  "endpoints": [
    {
      "endpoint": "/v1/bd/onboarding/sessions",
      "method": "POST",
      "input_headers": ["Authorization", "Content-Type", "Accept", "X-Request-ID", "X-Org-Id", "X-User-Id", "X-User-Email", "X-Role", "X-Is-Admin", "X-Phone-Number", "X-User-IsAdmin"],
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/v1/bd/onboarding",
          "method": "POST",
          "host": ["http://bd.liquidity.svc.cluster.local:8080"],
          "encoding": "no-op"
        }
      ]
    },
    {
      "endpoint": "/v1/bd/onboarding/sessions/{id}",
      "method": "GET",
      "input_headers": ["Authorization", "Content-Type", "Accept", "X-Request-ID", "X-Org-Id", "X-User-Id", "X-User-Email", "X-Role", "X-Is-Admin", "X-Phone-Number", "X-User-IsAdmin"],
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/v1/bd/onboarding/{id}",
          "method": "GET",
          "host": ["http://bd.liquidity.svc.cluster.local:8080"],
          "encoding": "no-op"
        }
      ]
    },
    {
      "endpoint": "/v1/bd/onboarding/sessions/{id}/steps/identity",
      "method": "PUT",
      "input_headers": ["Authorization", "Content-Type", "Accept", "X-Request-ID", "X-Org-Id", "X-User-Id", "X-User-Email", "X-Role", "X-Is-Admin", "X-Phone-Number", "X-User-IsAdmin"],
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/v1/bd/onboarding/{id}/identity",
          "method": "POST",
          "host": ["http://bd.liquidity.svc.cluster.local:8080"],
          "encoding": "no-op"
        }
      ]
    },
    {
      "endpoint": "/v1/bd/onboarding/sessions/{id}/steps/screening",
      "method": "PUT",
      "input_headers": ["Authorization", "Content-Type", "Accept", "X-Request-ID", "X-Org-Id", "X-User-Id", "X-User-Email", "X-Role", "X-Is-Admin", "X-Phone-Number", "X-User-IsAdmin"],
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/v1/bd/onboarding/{id}/screen",
          "method": "POST",
          "host": ["http://bd.liquidity.svc.cluster.local:8080"],
          "encoding": "no-op"
        }
      ]
    },
    {
      "endpoint": "/v1/bd/onboarding/sessions/{id}/steps/submission",
      "method": "PUT",
      "input_headers": ["Authorization", "Content-Type", "Accept", "X-Request-ID", "X-Org-Id", "X-User-Id", "X-User-Email", "X-Role", "X-Is-Admin", "X-Phone-Number", "X-User-IsAdmin"],
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/v1/bd/onboarding/{id}/submit",
          "method": "POST",
          "host": ["http://bd.liquidity.svc.cluster.local:8080"],
          "encoding": "no-op"
        }
      ]
    },
    {
      "endpoint": "/v1/bd/compliance/applications",
      "method": "POST",
      "input_headers": ["Authorization", "Content-Type", "Accept", "X-Request-ID", "X-Org-Id", "X-User-Id", "X-User-Email", "X-Role", "X-Is-Admin", "X-Phone-Number", "X-User-IsAdmin"],
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/v1/bd/compliance/applications",
          "method": "POST",
          "host": ["http://bd.liquidity.svc.cluster.local:8080"],
          "encoding": "no-op"
        }
      ]
    },
    {
      "endpoint": "/v1/bd/compliance/applications/{id}",
      "method": "GET",
      "input_headers": ["Authorization", "Content-Type", "Accept", "X-Request-ID", "X-Org-Id", "X-User-Id", "X-User-Email", "X-Role", "X-Is-Admin", "X-Phone-Number", "X-User-IsAdmin"],
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/v1/bd/compliance/applications/{id}",
          "method": "GET",
          "host": ["http://bd.liquidity.svc.cluster.local:8080"],
          "encoding": "no-op"
        }
      ]
    },
    {
      "endpoint": "/v1/bd/compliance/applications/{id}/submit",
      "method": "POST",
      "input_headers": ["Authorization", "Content-Type", "Accept", "X-Request-ID", "X-Org-Id", "X-User-Id", "X-User-Email", "X-Role", "X-Is-Admin", "X-Phone-Number", "X-User-IsAdmin"],
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/v1/bd/compliance/applications/{id}/submit",
          "method": "POST",
          "host": ["http://bd.liquidity.svc.cluster.local:8080"],
          "encoding": "no-op"
        }
      ]
    }
  ]
}
