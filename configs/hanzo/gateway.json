{
  "$schema": "https://www.krakend.io/schema/v3.json",
  "version": 3,
  "name": "Hanzo API Gateway",
  "port": 8080,
  "timeout": "120s",
  "cache_ttl": "0s",
  "output_encoding": "no-op",
  "extra_config": {
    "router": {
      "return_error_msg": true
    },
    "qos/ratelimit/router": {
      "max_rate": 5000,
      "client_max_rate": 100,
      "strategy": "ip"
    },
    "telemetry/logging": {
      "level": "INFO",
      "prefix": "[GATEWAY]",
      "syslog": false,
      "stdout": true
    }
  },
  "endpoints": [
    {
      "endpoint": "/v1/chat/completions",
      "method": "POST",
      "input_headers": ["*"],
      "output_encoding": "no-op",
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 500,
          "client_max_rate": 10,
          "strategy": "ip",
          "every": "1m"
        }
      },
      "backend": [
        {
          "url_pattern": "/api/chat/completions",
          "host": ["http://cloud.hanzo.svc.cluster.local:80"],
          "encoding": "no-op"
        }
      ]
    },
    {
      "endpoint": "/v1/completions",
      "method": "POST",
      "input_headers": ["*"],
      "output_encoding": "no-op",
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 500,
          "client_max_rate": 10,
          "strategy": "ip",
          "every": "1m"
        }
      },
      "backend": [
        {
          "url_pattern": "/api/chat/completions",
          "host": ["http://cloud.hanzo.svc.cluster.local:80"],
          "encoding": "no-op"
        }
      ]
    },
    {
      "endpoint": "/v1/embeddings",
      "method": "POST",
      "input_headers": ["*"],
      "output_encoding": "no-op",
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 1000,
          "client_max_rate": 30,
          "strategy": "ip",
          "every": "1m"
        }
      },
      "backend": [
        {
          "url_pattern": "/api/chat/completions",
          "host": ["http://cloud.hanzo.svc.cluster.local:80"],
          "encoding": "no-op"
        }
      ]
    },
    {
      "endpoint": "/v1/models",
      "method": "GET",
      "input_headers": ["*"],
      "output_encoding": "no-op",
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 500,
          "client_max_rate": 60,
          "strategy": "ip",
          "every": "1m"
        }
      },
      "backend": [
        {
          "url_pattern": "/api/get-providers",
          "host": ["http://cloud.hanzo.svc.cluster.local:80"],
          "encoding": "no-op"
        }
      ]
    },
    {
      "endpoint": "/v1/images/generations",
      "method": "POST",
      "input_headers": ["*"],
      "output_encoding": "no-op",
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 200,
          "client_max_rate": 5,
          "strategy": "ip",
          "every": "1m"
        }
      },
      "backend": [
        {
          "url_pattern": "/api/chat/completions",
          "host": ["http://cloud.hanzo.svc.cluster.local:80"],
          "encoding": "no-op"
        }
      ]
    },
    {
      "endpoint": "/v1/audio/transcriptions",
      "method": "POST",
      "input_headers": ["*"],
      "output_encoding": "no-op",
      "extra_config": {
        "qos/ratelimit/router": {
          "max_rate": 200,
          "client_max_rate": 5,
          "strategy": "ip",
          "every": "1m"
        }
      },
      "backend": [
        {
          "url_pattern": "/api/process-speech-to-text",
          "host": ["http://cloud.hanzo.svc.cluster.local:80"],
          "encoding": "no-op"
        }
      ]
    },
    {
      "endpoint": "/api/{path}",
      "method": "GET",
      "input_headers": ["*"],
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/api/{path}",
          "host": ["http://cloud.hanzo.svc.cluster.local:80"],
          "encoding": "no-op"
        }
      ]
    },
    {
      "endpoint": "/api/{path}",
      "method": "POST",
      "input_headers": ["*"],
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/api/{path}",
          "host": ["http://cloud.hanzo.svc.cluster.local:80"],
          "encoding": "no-op"
        }
      ]
    },
    {
      "endpoint": "/commerce/{path}",
      "method": "GET",
      "input_headers": ["*"],
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/{path}",
          "host": ["http://commerce.hanzo.svc.cluster.local:8001"],
          "encoding": "no-op"
        }
      ]
    },
    {
      "endpoint": "/commerce/{path}",
      "method": "POST",
      "input_headers": ["*"],
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/{path}",
          "host": ["http://commerce.hanzo.svc.cluster.local:8001"],
          "encoding": "no-op"
        }
      ]
    },
    {
      "endpoint": "/auth/{path}",
      "method": "GET",
      "input_headers": ["*"],
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/api/{path}",
          "host": ["http://iam.hanzo.svc.cluster.local:8000"],
          "encoding": "no-op"
        }
      ]
    },
    {
      "endpoint": "/auth/{path}",
      "method": "POST",
      "input_headers": ["*"],
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/api/{path}",
          "host": ["http://iam.hanzo.svc.cluster.local:8000"],
          "encoding": "no-op"
        }
      ]
    },
    {
      "endpoint": "/analytics/{path}",
      "method": "GET",
      "input_headers": ["*"],
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/{path}",
          "host": ["http://analytics.hanzo.svc.cluster.local:80"],
          "encoding": "no-op"
        }
      ]
    },
    {
      "endpoint": "/analytics/{path}",
      "method": "POST",
      "input_headers": ["*"],
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/{path}",
          "host": ["http://analytics.hanzo.svc.cluster.local:80"],
          "encoding": "no-op"
        }
      ]
    },
    {
      "endpoint": "/health",
      "method": "GET",
      "output_encoding": "json",
      "backend": [
        {
          "url_pattern": "/__health",
          "host": ["http://localhost:8080"],
          "encoding": "json"
        }
      ]
    }
  ]
}
