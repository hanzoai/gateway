{
  "$schema": "https://www.krakend.io/schema/v3.json",
  "version": 3,
  "name": "Lux API Gateway",
  "timeout": "30s",
  "cache_ttl": "0s",
  "output_encoding": "no-op",
  "extra_config": {
    "router": {
      "return_error_msg": true
    },
    "qos/ratelimit/router": {
      "max_rate": 1000,
      "client_max_rate": 100,
      "strategy": "ip"
    }
  },
  "endpoints": [
    {
      "endpoint": "/ext/bc/C/rpc",
      "method": "POST",
      "input_headers": ["*"],
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/ext/bc/C/rpc",
          "host": ["http://luxd.lux-mainnet.svc.cluster.local:9630"],
          "encoding": "no-op"
        }
      ]
    },
    {
      "endpoint": "/mainnet/ext/bc/C/rpc",
      "method": "POST",
      "input_headers": ["*"],
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/ext/bc/C/rpc",
          "host": ["http://luxd.lux-mainnet.svc.cluster.local:9630"],
          "encoding": "no-op"
        }
      ]
    },
    {
      "endpoint": "/testnet/ext/bc/C/rpc",
      "method": "POST",
      "input_headers": ["*"],
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/ext/bc/C/rpc",
          "host": ["http://luxd.lux-testnet.svc.cluster.local:9640"],
          "encoding": "no-op"
        }
      ]
    },
    {
      "endpoint": "/devnet/ext/bc/C/rpc",
      "method": "POST",
      "input_headers": ["*"],
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/ext/bc/C/rpc",
          "host": ["http://luxd.lux-devnet.svc.cluster.local:9650"],
          "encoding": "no-op"
        }
      ]
    },
    {
      "endpoint": "/ext/info",
      "method": "POST",
      "input_headers": ["*"],
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/ext/info",
          "host": ["http://luxd.lux-mainnet.svc.cluster.local:9630"],
          "encoding": "no-op"
        }
      ]
    }
  ]
}
