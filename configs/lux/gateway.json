{
  "$schema": "https://gateway.hanzo.ai/schema/v3.json",
  "version": 3,
  "name": "Lux API Gateway",
  "port": 8080,
  "timeout": "30s",
  "cache_ttl": "0s",
  "output_encoding": "no-op",
  "extra_config": {
    "router": {
      "return_error_msg": true
    },
    "qos/ratelimit/router": {
      "max_rate": 1000,
      "client_max_rate": 100,
      "strategy": "ip"
    }
  },
  "endpoints": [
    {
      "endpoint": "/ext/bc/C/rpc",
      "method": "POST",
      "input_headers": ["*"],
      "output_encoding": "no-op",
      "backend": [{
        "url_pattern": "/ext/bc/C/rpc",
        "host": ["http://luxd.lux-mainnet.svc.cluster.local:9630"],
        "encoding": "no-op"
      }]
    },
    {
      "endpoint": "/ext/bc/C/ws",
      "method": "GET",
      "input_headers": ["*"],
