# Hanzo AI Inference Gateway - Environment Configuration
# Copy this to .env and fill in your actual values

# ============================================================================
# DigitalOcean Gradient AI Platform API Key
# ============================================================================
# Get your key from: https://cloud.digitalocean.com/ai/serverless-inference
# Format: dop_v1_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
DIGITALOCEAN_API_KEY=

# Optional: Additional provider API keys for commercial models
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ============================================================================
# Service Configuration
# ============================================================================
NODE_ENV=production

# Inference Service (inference.hanzo.ai)
INFERENCE_PORT=3001
INFERENCE_HOST=0.0.0.0

# Embedding Service (embedding.hanzo.ai)
EMBEDDING_PORT=3002
EMBEDDING_HOST=0.0.0.0

# ============================================================================
# Database & Cache
# ============================================================================
# PostgreSQL - User data, device registry, usage logs
DATABASE_URL=postgresql://hanzo_user:CHANGE_THIS_PASSWORD@localhost:5432/hanzo_gateway

# Redis - Rate limiting, session cache
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# Security & Authentication
# ============================================================================
# JWT Secret for session tokens (generate with: openssl rand -base64 32)
JWT_SECRET=

# Admin dashboard password (bcrypt hash)
ADMIN_PASSWORD_HASH=

# ============================================================================
# Rate Limiting Configuration
# ============================================================================
# Free Tier
FREE_TIER_REQUESTS_PER_DAY=100
FREE_TIER_TOKENS_PER_DAY=10000
FREE_TIER_REQUESTS_PER_MINUTE=5
FREE_TIER_MODELS=llama3-8b-instruct,mistral-nemo-instruct-2407

# Paid Tier
PAID_TIER_REQUESTS_PER_DAY=10000
PAID_TIER_TOKENS_PER_DAY=1000000
PAID_TIER_REQUESTS_PER_MINUTE=100

# Global Limits (Cost Protection)
GLOBAL_REQUESTS_PER_DAY=50000
GLOBAL_MAX_COST_PER_DAY_USD=50.00

# ============================================================================
# Cost Management
# ============================================================================
# Daily budget limit (service auto-pauses if exceeded)
DAILY_BUDGET_USD=50.00

# Cost tracking
ENABLE_COST_TRACKING=true
COST_ALERT_THRESHOLD_PERCENT=80

# ============================================================================
# Model Configuration
# ============================================================================
# Default models for free tier
DEFAULT_INFERENCE_MODEL=llama3-8b-instruct
DEFAULT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Model pricing (USD per 1M tokens)
# These are approximate - adjust based on actual DO pricing
MODEL_COST_LLAMA3_8B_INPUT=0.10
MODEL_COST_LLAMA3_8B_OUTPUT=0.10
MODEL_COST_LLAMA3_70B_INPUT=0.50
MODEL_COST_LLAMA3_70B_OUTPUT=0.50

# ============================================================================
# Monitoring & Alerts
# ============================================================================
# Slack webhook for alerts
SLACK_WEBHOOK_URL=

# Email alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL=admin@hanzo.ai

# Sentry error tracking (optional)
SENTRY_DSN=

# ============================================================================
# Feature Flags
# ============================================================================
# Require manual device approval
REQUIRE_DEVICE_APPROVAL=true

# Enable trial period for new users
ENABLE_FREE_TRIAL=true
TRIAL_DURATION_DAYS=7

# Enable IP-based rate limiting
ENABLE_IP_RATE_LIMITING=true

# Enable usage analytics
ENABLE_ANALYTICS=true

# ============================================================================
# AWS Secrets Manager (Production)
# ============================================================================
# Use AWS Secrets Manager instead of env vars in production
USE_AWS_SECRETS_MANAGER=false
AWS_REGION=us-east-1
AWS_SECRETS_PREFIX=hanzo-gateway

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=info
LOG_FORMAT=json
ENABLE_REQUEST_LOGGING=true
ENABLE_COST_LOGGING=true

# ============================================================================
# CORS Configuration
# ============================================================================
CORS_ORIGINS=https://app.hanzo.ai,tauri://localhost

# ============================================================================
# Stripe Integration (for paid tiers)
# ============================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_ANNUAL=
